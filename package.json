{
  "name": "coupon-booklet",
  "version": "1.2.4",
  "private": true,
  "description": "Store coupons for websites. No external websites involved. Just a specialized store. ",
  "license": "MPL-2.0",
  "repository": "github:freaktechnik/coupon-booklet",
  "homepage": "https://github.com/freaktechnik/coupon-booklet#readme",
  "bugs": "https://github.com/freaktechnik/coupon-booklet/issues",
  "author": "Martin Giger (https://humanoids.be)",
  "type": "module",
  "main": "./background.js",
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "test": "npm run lint",
    "lint": "npm run lint:js && npm run lint:webext",
    "lint:js": "eslint .",
    "lint:webext": "web-ext lint",
    "build": "web-ext build"
  },
  "devDependencies": {
    "@freaktechnik/eslint-config-extension": "^14.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-optimize-regex": "^1.2.1",
    "web-ext": "^10.8.0"
  },
  "browserslist": [
    "last 1 firefox version",
    "firefox esr"
  ],
  "webExt": {
    "ignoreFiles": [
      "package.json",
      "package-lock.json",
      ".tx",
      "README.md"
    ]
  }
}
